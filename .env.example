# Use Alpaca PAPER-account keys. The application hard-codes paper=True and has
# no live-trading mode.
ALPACA_API_KEY=replace_me
ALPACA_API_SECRET=replace_me

# Kept for compatibility with the original project. alpaca-py selects the
# paper endpoint via paper=True, so this value is informational only.
ALPACA_PAPER_ENDPOINT=https://paper-api.alpaca.markets
